# --- AgentMeter public surface ---
# A fresh public repo built from this tree should contain only AgentMeter's own
# code and docs. The entries below keep internal agent tooling, inherited upstream
# marketing/site, and personal release config out of the public surface. See
# docs/FORKING.md and the publish runbook.

# Internal agent operating system (private)
AGENTS.md
CLAUDE.md
PLAN.md
goal.txt
.agent/
.agents/
.claude/
.codex/

# Inherited CodexBar marketing / site / release feed (not part of AgentMeter)
codexbar.png
appcast.xml
CHANGELOG.md

# Icon Composer source + the vestigial repo-root icns are superseded by
# Scripts/build_icon.sh, which regenerates the shipped Sources/CodexBar/Resources/Icon-classic.icns.
Icon.icon/
/Icon.icns

# Ship only AgentMeter docs, not the inherited CodexBar docs site (CNAME, index.html, provider pages)
docs/*
!docs/FORKING.md
!docs/usage-export.md
!docs/images/

# Private/inherited release and upstream-maintenance helpers are not part of the source-only
# AgentMeter public surface. Keep the AgentMeter local package/install/verify scripts instead.
bin/install-codexbar-cli.sh
Scripts/analyze_quotio.sh
Scripts/check-release-assets.sh
Scripts/check_upstreams.sh
Scripts/changelog-to-html.sh
Scripts/compile_and_run.sh
Scripts/docs-list.mjs
Scripts/generate-llms.mjs
Scripts/launch.sh
Scripts/make_appcast.sh
Scripts/package_app.sh
Scripts/package_product_paths.sh
Scripts/prepare_upstream_pr.sh
Scripts/release.sh
Scripts/release_artifacts.sh
Scripts/release_dsym_paths.sh
Scripts/review_upstream.sh
Scripts/setup_dev_signing.sh
Scripts/sign-and-notarize.sh
Scripts/test_live_update.sh
Scripts/test_package_product_paths.sh
Scripts/test_release_dsym_paths.sh
Scripts/test_sparkle_signing_paths.sh
Scripts/validate_changelog.sh
