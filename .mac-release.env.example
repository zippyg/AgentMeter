# AgentMeter signed-release configuration template.
#
# Only needed if you distribute a signed, notarized, Sparkle-updated macOS binary.
# Source-only use does not need this file. Copy to `.mac-release.env` (gitignored) and
# fill in your own values. Never commit real signing material or service-account tokens;
# reference them via your secret manager (for example the 1Password `op` CLI) or a key file.

MAC_RELEASE_APP_NAME=AgentMeter
MAC_RELEASE_REPO=your-org/AgentMeter
MAC_RELEASE_BUNDLE_ID=com.your-org.agentmeter.menu
MAC_RELEASE_VERSION_FILE=version.env
MAC_RELEASE_APPCAST=appcast.xml
MAC_RELEASE_SOURCE_FILES=
MAC_RELEASE_ARTIFACT_PREFIX=AgentMeter

# Sparkle: your PUBLIC EdDSA key is safe to commit; the private key is not.
MAC_RELEASE_SUPUBLIC_ED_KEY=your-sparkle-ed25519-public-key
MAC_RELEASE_SIGNING_KEY_FILE=/path/to/your/private/key-not-in-repo
MAC_RELEASE_FEED_URL=https://raw.githubusercontent.com/your-org/AgentMeter/main/appcast.xml
MAC_RELEASE_DOWNLOAD_URL_PREFIX=https://github.com/your-org/AgentMeter/releases/download/

# Code signing. Reference secrets, do not inline them.
MAC_RELEASE_CODESIGN_IDENTITY=Developer ID Application: Your Name (TEAMID)
MAC_RELEASE_CODESIGN_OP_ITEM=
MAC_RELEASE_CODESIGN_OP_VAULT=
MAC_RELEASE_CODESIGN_OP_USE_SERVICE_ACCOUNT=false
MAC_RELEASE_CODESIGN_KEYCHAIN_MANAGED=false

MAC_RELEASE_TAG_SIGNED=false
MAC_RELEASE_TAG_FORCE=false
MAC_RELEASE_GENERATE_APPCAST_ARGS=
MAC_RELEASE_EXTRA_ASSET_WAIT_SECONDS=0
MAC_RELEASE_EXTRA_ASSET_WAIT_INTERVAL=5
MAC_RELEASE_EXTRA_ASSET_PATTERNS=
